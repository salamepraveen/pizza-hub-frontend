package com.prav.order.repository;

import java.util.List;
import org.springframework.data.jpa.repository.JpaRepository;
import com.prav.order.model.PizzaOrder;

public interface PizzaOrderRepository extends JpaRepository<PizzaOrder, Long> {
    List<PizzaOrder> findByUserId(Long userId);
    List<PizzaOrder> findByStatus(String status);
    List<PizzaOrder> findByUserIdAndStatus(Long userId, String status);
    List<PizzaOrder> findByRestaurantId(Long restaurantId);
}